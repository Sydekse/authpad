# authpad configuration, as read by auth.LoadFromEnv().
# Only AUTH_DATABASE_URL, PEPPER_KEY and SESSION_SECRET are required.

# --- Core ---
PORT=8080
ENV=development
AUTHPAD_API_BASE_PATH=/api/v1

# Auth and IdP may point at the same physical database; the two migration
# ledgers are kept apart by MigrateWithOptions.
AUTH_DATABASE_URL=postgres://authpad:authpad@localhost:5432/authpad?sslmode=disable
IDP_DATABASE_URL=postgres://authpad:authpad@localhost:5432/authpad?sslmode=disable

# --- Secrets ---
PEPPER_KEY=
SESSION_SECRET=
# Grants service-to-service calls a CSRF exemption; leave empty to disable.
SERVICE_KEY=

# --- Sessions ---
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL=168h
SESSION_IDLE_TIMEOUT=24h
SESSION_MAX_LIFETIME=720h
SESSION_REMEMBER_TTL=720h

# --- Security ---
CSRF_ENABLED=true
RATE_LIMIT_RPM=15
RATE_LIMIT_BURST=5
PASSWORD_MIN_LENGTH=8
ADMIN_ROLE_NAME=admin
REDIS_URL=
# Reverse proxies (CIDRs or IPs, comma-separated) whose X-Forwarded-For is trusted for client IPs
# (rate limits, audit). Empty ignores the header. Behind Traefik set its network, e.g. 172.18.0.0/16.
TRUSTED_PROXY_CIDRS=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- OAuth ---
# Required in production: OAuth redirects not on this list are rejected.
OAUTH_ALLOWED_REDIRECTS=http://localhost:3000/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ---
APP_NAME=Auth
RESEND_API_KEY=
RESEND_FROM=
REQUIRE_EMAIL_VERIFICATION=false
# Email branding (docs/emails.md). All optional; empty uses the neutral defaults.
# EMAIL_HEADER_COLOR=#1f2937
# EMAIL_BUTTON_COLOR=#111827
# EMAIL_LOGO_URL=https://example.com/email-logo.png
# EMAIL_LOGO_WIDTH=132
# EMAIL_LOGO_HEIGHT=
# EMAIL_FONT_FAMILY=-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif
# EMAIL_HEADING_FONT_FAMILY=
# EMAIL_FOOTER_TEXT=Sent by {app}.
# EMAIL_ORG_INVITE_TITLE=You've been invited to join {org} on {app}
# EMAIL_ORG_INVITE_BODY=Accept the invite to join the {org} team on {app}.
# EMAIL_ORG_INVITE_BUTTON=Accept invite

# --- Hosted pages ---
SIGN_IN_URL=
SIGN_UP_URL=
VERIFY_EMAIL_URL=
RESET_PASSWORD_URL=
CALLBACK_URL=
ERROR_URL=

# --- Roles ---
ROLES=admin,member

# --- Optional: signup and invitations ---
# Turn off when the host owns account creation.
DISABLE_PUBLIC_SIGNUP=false
AUTHPAD_INVITATIONS_ENABLED=false
AUTHPAD_INVITE_TTL=168h
# Origins an invite callback_url may use. Empty: ALLOWED_ORIGINS, MAGIC_LINK_REDIRECT_ALLOWLIST and the hosted page origins.
AUTHPAD_INVITE_CALLBACK_ORIGINS=

# --- Optional: company tenancy (requires IDP_DATABASE_URL) ---
AUTHPAD_TENANCY_ENABLED=false
AUTHPAD_TENANCY_PERSONAL=true
AUTHPAD_TENANCY_CREATE_ORG=true
AUTHPAD_TENANCY_REQUIRE_ON_SIGNUP=false
# 0 means unlimited; set 1 for single-workspace products.
AUTHPAD_TENANCY_MAX_MEMBERSHIPS=0
AUTHPAD_TENANCY_DEFAULT_ORG_ROLE=member
# Profile metadata keys hidden unless the session has an active organization.
AUTHPAD_TENANCY_ORG_PRIVATE_FIELDS=

# --- Optional: magic-link sign-in (requires tenancy; see docs/magic-link.md) ---
MAGIC_LINK_ENABLED=false
# Public origin of this API; links are BASE_URL + AUTHPAD_API_BASE_PATH + /magic-link/verify
MAGIC_LINK_BASE_URL=http://localhost:8080
# Sender address; falls back to RESEND_FROM. Mail needs RESEND_API_KEY (empty in
# development prints the link to stdout; production refuses to start without it).
MAGIC_LINK_FROM=
# Comma-separated exact origins (scheme://host[:port]) redirect_to may use.
MAGIC_LINK_REDIRECT_ALLOWLIST=http://localhost:3000
# Where to go when redirect_to is missing or not allowed (falls back to CALLBACK_URL).
MAGIC_LINK_DEFAULT_REDIRECT=
MAGIC_LINK_TTL=15m
MAGIC_LINK_EMAIL_LIMIT=5
MAGIC_LINK_IP_LIMIT=20
MAGIC_LINK_LIMIT_WINDOW=15m
# Accounts that have a password are refused by default (staff/admin always are).
# Setting true also lets an unverified password account in, after its sessions,
# password and MFA are wiped (see docs/magic-link.md).
MAGIC_LINK_ALLOW_PASSWORD_ACCOUNTS=false
# Code flow: for apps on another registrable domain. Verify redirects with ?code=<one-time code>
# instead of setting an authpad cookie; the app redeems it at POST /magic-link/exchange.
# Requires MAGIC_LINK_DEFAULT_REDIRECT or CALLBACK_URL, a PKCE code_challenge (S256) on
# POST /magic-link and the code_verifier at exchange. Needs migration 000009.
MAGIC_LINK_CODE_FLOW=false
# Required when code flow is on (>= 32 chars in production); sent as X-Authpad-Exchange-Secret.
# Empty disables the exchange endpoint (404).
MAGIC_LINK_EXCHANGE_SECRET=
# Exchange attempts per IP per minute (0 disables)
MAGIC_LINK_EXCHANGE_LIMIT=60
